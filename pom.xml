<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.justinus</groupId>
  <artifactId>justinus-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>justinus-api</name>
  <description>Personal knowledge-tracking backend (Zettelkasten-style PKM engine)</description>

  <properties>
    <java.version>25</java.version>
    <!--
      Spring Boot 4.1.1 manages tomcat.version=11.0.24, which has three
      CRITICAL CVEs (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525)
      fixed in 11.0.25. No newer 4.1.x Spring Boot patch exists yet to
      pick this up automatically, so override directly until one does.
    -->
    <tomcat.version>11.0.25</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-neo4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <!--
        Not managed by spring-boot-starter-parent's BOM (third-party,
        not a Spring Boot module): version is pinned explicitly and
        needs manual bumping, unlike everything else in this file.
      -->
      <groupId>eu.michael-simons.neo4j</groupId>
      <artifactId>neo4j-migrations-spring-boot-starter</artifactId>
      <version>4.2.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-neo4j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!--
            Testcontainers' Ryuk cleanup sidecar tries to bind-mount the
            Docker socket path into its own container. On lightweight/VM
            Docker runtimes (Colima, and plenty of CI runners) that mount
            fails because the path doesn't translate into the runtime's
            Linux VM the way it would on Docker Desktop. Disabling Ryuk
            trades away automatic orphaned-container cleanup after a hard
            JVM crash (rare, and cheap to clean up manually) for tests
            actually running. This is env-var-only in Testcontainers,
            with no equivalent ~/.testcontainers.properties key.
          -->
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
