meta {
  name: Create Note (nested)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sources/{{sourceId}}/notes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "content": "The dichotomy of control is the whole of the philosophy.",
    "locationRef": "ch. 1",
    "tags": ["control", "core-idea"]
  }
}

vars:post-response {
  noteId: res.body.id
}
