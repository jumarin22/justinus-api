meta {
  name: Create Concept
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/concepts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Dichotomy of control",
    "description": "Some things are up to us, some are not."
  }
}

vars:post-response {
  conceptId: res.body.id
}
